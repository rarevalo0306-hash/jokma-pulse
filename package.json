{
  "name": "jokma-pulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Atención al cliente por empresa, cuenta y canal.",
  "scripts": {
    "start": "node server.js",
    "start:local": "node scripts/start-local.mjs",
    "start:public": "node scripts/start-public.mjs",
    "admin:reset-password": "node scripts/admin-reset-password.mjs",
    "test": "node --test",
    "supabase:auth:local": "node scripts/provision-local-auth.mjs",
    "supabase:import:dry-run": "node scripts/import-supabase.mjs",
    "supabase:backup:local": "node scripts/backup-local.mjs",
    "supabase:backup:verify": "node scripts/verify-backup-local.mjs",
    "supabase:auth:repair-sequences": "node scripts/repair-local-auth-sequences.mjs",
    "verify:registration": "node scripts/verify-registration.mjs",
    "verify:workspaces": "node scripts/verify-workspaces.mjs",
    "verify:team": "node scripts/verify-team.mjs",
    "verify:recovery": "node scripts/verify-recovery.mjs",
    "verify:account-access": "node scripts/verify-account-access.mjs",
    "mobile:sync": "cap sync",
    "mobile:ios": "cap open ios",
    "mobile:android": "cap open android",
    "mobile:build:ios": "xcodebuild -project ios/App/App.xcodeproj -scheme App -sdk iphonesimulator -configuration Debug CODE_SIGNING_ALLOWED=NO build",
    "mobile:build:android": "JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home ANDROID_HOME=/opt/homebrew/share/android-commandlinetools ./android/gradlew -p android assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@supabase/supabase-js": "2.119.0",
    "express": "^4.21.2",
    "imapflow": "2.11.0",
    "mailparser": "3.14.3",
    "nodemailer": "10.5.0",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "puppeteer-core": "25.17.0"
  }
}
